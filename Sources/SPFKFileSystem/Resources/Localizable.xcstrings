    "That name can't be used. Names cannot be empty or contain a slash." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Name kann nicht verwendet werden. Namen dürfen nicht leer sein und keinen Schrägstrich enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That name can't be used. Names cannot be empty or contain a slash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese nombre no se puede usar. Los nombres no pueden estar vacíos ni contener una barra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce nom ne peut pas être utilisé. Les noms ne peuvent pas être vides ni contenir de barre oblique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo nome non può essere usato. I nomi non possono essere vuoti né contenere una barra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前は使用できません。名前を空にすることはできず、スラッシュを含めることもできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이름은 사용할 수 없습니다. 이름은 비워 둘 수 없으며 슬래시를 포함할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die naam kan niet worden gebruikt. Namen mogen niet leeg zijn en geen schuine streep bevatten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse nome não pode ser usado. Os nomes não podem estar vazios nem conter uma barra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это имя нельзя использовать. Имя не может быть пустым или содержать косую черту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用该名称。名称不能为空，也不能包含斜杠。"
          }
        }
      }
