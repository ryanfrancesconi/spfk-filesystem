        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In „%@“ kann nicht geschrieben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" can't be written to."
          }
        },
