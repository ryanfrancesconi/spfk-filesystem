    "\"%@\" is inside a package or a Photos library, so files can't be moved into it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ befindet sich in einem Paket oder einer Fotos-Mediathek, daher können keine Dateien dorthin verschoben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is inside a package or a Photos library, so files can't be moved into it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está dentro de un paquete o de una biblioteca de Fotos, por lo que no se pueden mover archivos a su interior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » se trouve dans un paquet ou une bibliothèque Photos : impossible d’y déplacer des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” si trova in un pacchetto o in una libreria di Foto, quindi non è possibile spostarvi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はパッケージまたは写真ライブラリ内にあるため、ファイルを移動できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 패키지 또는 사진 라이브러리 안에 있으므로 파일을 그 안으로 이동할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ staat in een pakket of Fotobibliotheek, dus er kunnen geen bestanden naartoe worden verplaatst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está dentro de um pacote ou de uma biblioteca do Fotos, portanto não é possível mover arquivos para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» находится внутри пакета или медиатеки Фото, поэтому в него нельзя перемещать файлы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”位于软件包或照片图库内，因此无法将文件移入其中。"
          }
        }
      }
    },
    "\"%@\" is locked. Unlock it to rename it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ist gesperrt. Entsperren Sie die Datei, um sie umzubenennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is locked. Unlock it to rename it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" está bloqueado. Desbloquéalo para renombrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est verrouillé. Déverrouillez-le pour le renommer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" è bloccato. Sbloccalo per rinominarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はロックされています。名前を変更するにはロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"은(는) 잠겨 있습니다. 이름을 바꾸려면 잠금을 해제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is vergrendeld. Ontgrendel het bestand om het te hernoemen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" está bloqueado. Desbloqueie-o para renomeá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» заблокирован. Разблокируйте файл, чтобы переименовать его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已锁定。请解锁以重命名。"
          }
        }
      }
    },
